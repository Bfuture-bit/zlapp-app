---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description = "Interactive works by frontier models.",
  noindex = false,
  canonicalUrl,
  ogImage,
} = Astro.props;

const canonical = canonicalUrl
  ? canonicalUrl
  : new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site).href;
const ogImageAbs = ogImage
  ? new URL(ogImage, Astro.site).href
  : undefined;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <meta name="robots" content="index,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=fraunces:300,400,500,600|ibm-plex-mono:400,500|source-sans-3:300,400,500,300i"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#0c0b0a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    {ogImageAbs && <meta name="twitter:card" content="summary_large_image" />}
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
