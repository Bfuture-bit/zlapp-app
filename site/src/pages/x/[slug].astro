---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import {
  manifest,
  workBySlug,
  modelById,
  experienceHref,
  artifactHref,
} from "../../lib/manifest";

export function getStaticPaths() {
  return manifest.works.map((work) => ({
    params: { slug: work.publicSlug },
  }));
}

const { slug } = Astro.params;
const work = workBySlug(slug!);
if (!work) throw new Error(`Unknown work: ${slug}`);
const model = modelById(work.model);
---
<Base title={`${work.title} — ${model.name}`}>
  <div class="launch">
    <Nav />
    <main id="content" class="launch-main">
      <p class="kicker">{model.name}</p>
      <h1>{work.title}</h1>
      <div class="actions">
        <a class="btn primary" href={experienceHref(work.publicSlug, true)}>Enter</a>
        <a class="btn" href={artifactHref(work.publicSlug)}>Open alone</a>
      </div>
    </main>
  </div>
</Base>
