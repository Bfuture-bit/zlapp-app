---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import WorkRow from "../components/WorkRow.astro";
import { worksFor, exhibitionJsonLd, EXHIBITION_DESCRIPTION, manifest } from "../lib/manifest";

const actI = worksFor("self-directed");
const actII = worksFor("shared-prompt");
const actIIIa = worksFor("self-synthesis");
const actIIIb = worksFor("shared-synthesis");
---
<Base title="Zlapp" description={manifest.tagline ?? EXHIBITION_DESCRIPTION} jsonLd={exhibitionJsonLd()}>
  <Nav />
  <main id="content">
    <section class="section" id="act-i">
      <header>
        <p class="kicker">I</p>
        <h2>Self Made Prompt folder</h2>
      </header>
      <div class="work-list">
        {actI.map((work) => <WorkRow work={work} />)}
      </div>
    </section>

    <section class="section" id="act-ii">
      <header>
        <p class="kicker">II</p>
        <h2>Sol56 Led Prompt folder</h2>
      </header>
      <div class="work-list">
        {actII.map((work) => <WorkRow work={work} />)}
      </div>
    </section>

    <section class="section" id="act-iii">
      <header>
        <p class="kicker">III</p>
        <h2>Compilation folders</h2>
      </header>
      <p class="subhead">Self Made compilations</p>
      <div class="work-list">
        {actIIIa.map((work) => <WorkRow work={work} />)}
      </div>
      <p class="subhead">Light to Life compilations</p>
      <div class="work-list">
        {actIIIb.map((work) => <WorkRow work={work} />)}
      </div>
    </section>

    <section class="section" id="agent-glyphs">
      <header>
        <p class="kicker">Also</p>
        <h2>A machine lexicon</h2>
      </header>
      <div class="work-list">
        <a class="work work-glyph-entry" href="/agent-glyphs/" style="--c0:#12141a;--c1:#20c7c7;--c2:#ffa500">
          <div class="work-preview" aria-hidden="true">
            <img src="/agent-glyphs/contact-sheet.png" alt="" width="1200" height="750" loading="lazy" />
          </div>
          <div class="work-copy">
            <p class="who">AI-native visual state language</p>
            <h3>Agent Glyph</h3>
          </div>
        </a>
        <a class="work work-glyph-entry" href="/agent-glyphs2" style="--c0:#20242b;--c1:#23c7e8;--c2:#7657e8">
          <div class="work-preview" aria-hidden="true">
            <img src="/agent-glyphs2/contact-sheet.png" alt="" width="1200" height="750" loading="lazy" />
          </div>
          <div class="work-copy">
            <p class="who">Second-generation machine-native state language</p>
            <h3>GLYPHS 2</h3>
          </div>
        </a>
        <a class="work work-glyph-entry" href="https://vqx.zlapp.app/" style="--c0:#0b0d10;--c1:#7ec8c4;--c2:#c4b07e">
          <div class="work-preview" aria-hidden="true">
            <img src="/sites/vqx/assets/vqx-glyph-atlas.svg" alt="" width="1152" height="1152" loading="lazy" />
          </div>
          <div class="work-copy">
            <p class="who">Compact, deterministic coordination for AI agents</p>
            <h3>VQX</h3>
          </div>
        </a>
        <a class="work work-glyph-entry" href="/weekly-ads" style="--c0:#f4f0e8;--c1:#0f766e;--c2:#171412">
          <div class="work-preview" aria-hidden="true"></div>
          <div class="work-copy">
            <p class="who">Local grocery circulars</p>
            <h3>Weekly Ads</h3>
          </div>
        </a>
      </div>
    </section>
  </main>
</Base>
