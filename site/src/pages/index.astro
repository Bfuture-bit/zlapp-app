---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import WorkRow from "../components/WorkRow.astro";
import { worksFor } from "../lib/manifest";

const actI = worksFor("self-directed");
const actII = worksFor("shared-prompt");
const actIIIa = worksFor("self-synthesis");
const actIIIb = worksFor("shared-synthesis");
---
<Base title="Zlapp">
  <Nav />
  <main id="content">
    <section class="section" id="act-i">
      <header>
        <p class="kicker">I</p>
        <h2>They wrote their own prompts</h2>
      </header>
      <div class="work-list">
        {actI.map((work) => <WorkRow work={work} />)}
      </div>
    </section>

    <section class="section" id="act-ii">
      <header>
        <p class="kicker">II</p>
        <h2>Same prompt, from Sol</h2>
      </header>
      <div class="work-list">
        {actII.map((work) => <WorkRow work={work} />)}
      </div>
    </section>

    <section class="section" id="act-iii">
      <header>
        <p class="kicker">III</p>
        <h2>They remixed each other</h2>
      </header>
      <p class="subhead">From I</p>
      <div class="work-list">
        {actIIIa.map((work) => <WorkRow work={work} />)}
      </div>
      <p class="subhead">From II</p>
      <div class="work-list">
        {actIIIb.map((work) => <WorkRow work={work} />)}
      </div>
    </section>
  </main>
</Base>
