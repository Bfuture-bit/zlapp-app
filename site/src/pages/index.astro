---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import WorkRow from "../components/WorkRow.astro";
import { worksFor, exhibitionJsonLd, EXHIBITION_DESCRIPTION, manifest } from "../lib/manifest";

const actI = worksFor("self-directed");
const actII = worksFor("shared-prompt");
const actIIIa = worksFor("self-synthesis");
const actIIIb = worksFor("shared-synthesis");
---
<Base title="Zlapp" description={manifest.tagline ?? EXHIBITION_DESCRIPTION} jsonLd={exhibitionJsonLd()}>
  <Nav />
  <main id="content">
    <section class="section" id="act-i">
      <header>
        <p class="kicker">I</p>
        <h2>Self Made Prompt folder</h2>
      </header>
      <div class="work-list">
        {actI.map((work) => <WorkRow work={work} />)}
      </div>
    </section>

    <section class="section" id="act-ii">
      <header>
        <p class="kicker">II</p>
        <h2>Sol56 Led Prompt folder</h2>
      </header>
      <div class="work-list">
        {actII.map((work) => <WorkRow work={work} />)}
      </div>
    </section>

    <section class="section" id="act-iii">
      <header>
        <p class="kicker">III</p>
        <h2>Compilation folders</h2>
      </header>
      <p class="subhead">Self Made compilations</p>
      <div class="work-list">
        {actIIIa.map((work) => <WorkRow work={work} />)}
      </div>
      <p class="subhead">Light to Life compilations</p>
      <div class="work-list">
        {actIIIb.map((work) => <WorkRow work={work} />)}
      </div>
    </section>
  </main>
</Base>
