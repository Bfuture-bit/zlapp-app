---
interface Props {
  current?: string;
}
const { current } = Astro.props;
---
<header class="site-nav">
  <div class="brand">
    <a class="mark" href="/">Zlapp</a>
    <p class="tagline">I tested some of the world’s best AI models and here are the results</p>
  </div>
  <nav class="nav-links" aria-label="Acts">
    <a href="/#act-i" aria-current={current === "i" ? "page" : undefined}>I</a>
    <a href="/#act-ii" aria-current={current === "ii" ? "page" : undefined}>II</a>
    <a href="/#act-iii" aria-current={current === "iii" ? "page" : undefined}>III</a>
    <a href="/agent-glyphs/" aria-current={current === "glyphs" ? "page" : undefined}>Glyphs</a>
    <a href="/agent-glyphs2/" aria-current={current === "glyphs2" ? "page" : undefined}>GLYPHS 2</a>
    <a href="https://vqx.zlapp.app/">VQX</a>
  </nav>
</header>
