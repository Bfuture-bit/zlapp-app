---
interface Props {
  current?: string;
}
const { current } = Astro.props;
---
<header class="site-nav">
  <div class="brand">
    <a class="mark" href="/">Zlapp</a>
    <p class="tagline">Interactive HTML, attributed on-page to named models</p>
  </div>
  <nav class="nav-links" aria-label="Acts">
    <a href="/#act-i" aria-current={current === "i" ? "page" : undefined}>I</a>
    <a href="/#act-ii" aria-current={current === "ii" ? "page" : undefined}>II</a>
    <a href="/#act-iii" aria-current={current === "iii" ? "page" : undefined}>III</a>
  </nav>
</header>
