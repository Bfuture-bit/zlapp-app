{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vqx.zlapp.app/schemas/a2a-params-v0.3.schema.json",
  "title": "VQX 0.3 A2A AgentExtension params",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "dictionary_sha256", "modes"],
  "properties": {
    "protocol": {"const": "VQX"},
    "version": {"const": "0.3"},
    "dictionary_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["bootstrap", "compact"]}
    },
    "dynamic_macros": {"type": "boolean"},
    "max_frame_size": {"type": "integer", "minimum": 1, "maximum": 65535}
  }
}
